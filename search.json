---
layout: null
---
[
  {% for recipe in site.pages %}
    {% if recipe.title and recipe.url contains "recipe" %}
    {
      "title": {{ recipe.title | jsonify }},
      "url": {{ recipe.url | jsonify }},
      "content": {{ recipe.content | strip_html | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]
